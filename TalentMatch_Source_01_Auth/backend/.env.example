DATABASE_URL="postgresql://talentmatch:talentmatch_dev@localhost:5432/talentmatch?schema=public"
PORT=4000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
NODE_ENV=development
UPLOAD_DIR=uploads/public
MAIL_PROVIDER=smtp
# smtp = Mailpit or real SMTP; resend = HTTPS API (requires authorized sender)
MAIL_TIMEOUT_MS=10000
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="TalentMatch <no-reply@talentmatch.local>"
# Set MAIL_FROM to a Resend-verified domain sender when MAIL_PROVIDER=resend
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_API_VERSION=v22.0
